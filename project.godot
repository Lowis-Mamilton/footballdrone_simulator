; Engine configuration file.
; Edit through Godot when possible.

config_version=5

[application]

config/name="Football Drone Simulator"
config/version="1.0.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ProfileStore="*res://src/data/profile_store.gd"
ControlServer="*res://src/network/control_server.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/default_gravity=9.80665

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.015, 0.025, 0.045, 1)

[input]

arm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
reset_drone={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
toggle_camera={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
